<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- OPCION A (por defecto): LocalDB, viene con Visual Studio -->
    <add name="UniCampusDb"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=UniCampusDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
    <!-- OPCION B: SQL Server Express. Comente la de arriba y descomente esta:
    <add name="UniCampusDb"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=UniCampusDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
    -->
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Actividades.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
